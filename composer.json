{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "phpoffice/phpspreadsheet": "^5.5",
        "phpoffice/phpword": "^1.4",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#34d399\" \"php artisan serve --port=8090\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan reverb:start\" \"php artisan pail --timeout=0\" \"npm --prefix client run dev\" --names=server,queue,reverb,logs,client --kill-others"
        ],
        "dev:same-origin": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --port=8090\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan reverb:start\" \"php artisan pail --timeout=0\" --names=server,queue,reverb,logs --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "kerisi:extract-bl": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=bl --upload"
        ],
        "kerisi:extract-workflow": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=workflow --upload"
        ],
        "kerisi:extract-schema": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=schema --upload"
        ],
        "kerisi:extract-lookup": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=lookup --upload"
        ],
        "kerisi:extract-menu-access": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=menu_access --upload"
        ],
        "kerisi:extract-rbac": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=rbac --upload"
        ],
        "kerisi:extract-all": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan kerisi:extract-knowledge --section=all --upload"
        ],
        "kerisi:extract-tickets": [
            "@php artisan kerisi:process-tickets --upload"
        ],
        "kerisi:upgrade-ai": [
            "@php artisan kerisi:upgrade-ai"
        ],
        "kerisi:upload-ticket-guide": [
            "@php artisan kerisi:upload-ticket-guide"
        ],
        "ai:sync": [
            "@php scripts/ai-guidelines-sync.php"
        ],
        "ai:check": [
            "@php scripts/ai-guidelines-sync.php --check"
        ],
        "hooks:install": [
            "sh scripts/install-githooks.sh"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
