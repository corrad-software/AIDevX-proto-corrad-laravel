{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
  "scripts": {
    "build": "vite build",
    "build:admin": "npm --prefix client run build:laravel",
    "build:admin:watch": "npm --prefix client run build:laravel:watch",
    "dev": "vite",
    "dev:client": "npm --prefix client run dev",
        "dev:stack": "npx concurrently -c \"#93c5fd,#34d399\" \"php artisan serve --host=127.0.0.1 --port=8090\" \"npm --prefix client run dev\" --names=api,client --kill-others"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
