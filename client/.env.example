# Production / preview: asal penuh ke Laravel. Dev: env.ts guna window.location.origin (proxy Vite).
VITE_API_BASE_URL="http://127.0.0.1:8090"

# Vite dev: proksi /api, /sanctum ke backend. Lalai 127.0.0.1:8090 (composer dev).
# Keutamaan: env shell > fail ini > root .env. Guna 127.0.0.1 elak IPv6 localhost vs IPv4 serve.
# Contoh: php artisan serve --port=8000 → VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_PROXY_TARGET=http://127.0.0.1:8090

# Reverb WebSocket (live chat)
VITE_REVERB_APP_KEY=corrad-chat-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
