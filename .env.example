APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL frontend SPA (untuk pautan pengesahan e-mel daftar). Boleh berbilang, pisahkan dengan koma.
FRONTEND_URL=http://localhost:5173,http://localhost:5190,http://localhost:5191,http://localhost:8090

# Sanctum SPA cookie auth: host+port for Vite dev AND Laravel dev server (composer dev uses :8090).
# Must match the browser address bar (Origin). See config/sanctum.php.
SANCTUM_STATEFUL_DOMAINS=localhost:5190,localhost:5191,localhost:8090,127.0.0.1:8090,localhost,127.0.0.1

# Isu #2 — Vite (client/) proksi /api ke URL ini. Mesti sama dengan port Laravel (composer dev = 8090; php artisan serve = 8000).
# Guna 127.0.0.1 (bukan localhost) elak isu IPv6 ::1 vs IPv4 pada macOS.
# Keutamaan: env shell > client/.env > fail ini. Contoh: VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_PROXY_TARGET=http://127.0.0.1:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Untuk User Chat dalam iframe di MYFIS2 (domain lain), pada production HTTPS:
# SESSION_SAME_SITE=none
# SESSION_SECURE_COOKIE=true

# Asal dibenarkan embed SPA dalam <iframe> (CSP frame-ancestors). Pisahkan dengan koma.
# Contoh: https://myfisv2-tourism.datasc.dev
# KERISI_EMBED_IFRAME_ORIGINS=

# CORRAD (MYFIS) → KAIS: shared secret untuk URL signed SSO (/auth/corrad-sso). Mesti sama dengan PHP CORRAD.
# CORRAD_SSO_SECRET=
# CORRAD_SSO_MAX_AGE_SECONDS=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Reverb WebSocket (untuk live chat)
REVERB_APP_ID=corrad-chat
REVERB_APP_KEY=corrad-chat-key
REVERB_APP_SECRET=corrad-chat-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email (verification, password reset, in-app notification copies) ─────────
# For real delivery set MAIL_MAILER=smtp and fill host/user/pass. With MAIL_MAILER=log,
# messages go to laravel.log only; the app still creates in-app notifications.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Example production SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KERISI / MYFIS
# URL sistem KERISI untuk AI papar dalam jawapan navigasi (default: myfisv2-tourism)
KERISI_SYSTEM_URL=http://myfisv2-tourism.datasc.dev

# OpenAI (KERISI AI — Support Chat + User Chat)
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
OPENAI_ASSISTANT_ID=
# User Chat assistant (KB only, no SQL/schema). Run: php artisan kerisi:setup-user-chat
OPENAI_USER_CHAT_ASSISTANT_ID=

# Desk365 API (untuk fetch ticket dari datasc.desk365.io)
DESK365_BASE_URL=https://datasc.desk365.io/apis
DESK365_API_KEY=

# Akaun pentadbir lalai (UserSeeder) — ubah kata laluan dalam produksi
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=
# Jika ADMIN_PASSWORD kosong, seeder guna lalai pembangunan (lihat database/seeders/UserSeeder.php)
